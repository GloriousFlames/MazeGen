using MazeGen.Models;

namespace MazeGen.Services
{
    public class MazeService
    {
        private List<Maze> mazes = new List<Maze>();
        private Random rand = new Random();

        // 0 = wall, 1 = path
        public Maze CreateTemplate(int width, int height, Theme theme)
        {
            if (width % 2 == 0) width++;
            if (height % 2 == 0) height++;
            var grid = new int[width, height];
            for (int x = 0; x < width; x++)
                for (int y = 0; y < height; y++)
                    grid[x, y] = 0; // all walls

            return new Maze
            {
                Id = mazes.Count + 1,
                Width = width,
                Height = height,
                Theme = theme,
                Grid = grid,
                CreatedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
            };
        }

        public void PlaceEntranceExit(Maze maze, bool auto, Point? manualEntrance = null, Point? manualExit = null)
        {
            // Очистить предыдущие вход и выход (если были)
            if (maze.Entrance != Point.Empty)
                maze.Grid[maze.Entrance.X, maze.Entrance.Y] = 0;
            if (maze.Exit != Point.Empty)
                maze.Grid[maze.Exit.X, maze.Exit.Y] = 0;

            if (auto)
            {
                var perim = GetPerimeterCells(maze.Width, maze.Height);
                Point entrance, exit;
                do
                {
                    entrance = perim[rand.Next(perim.Count)];
                    exit = perim[rand.Next(perim.Count)];
                }
                while (!IsValidEntranceExit(entrance, exit, maze.Width, maze.Height));
                maze.Entrance = entrance;
                maze.Exit = exit;
            }
            else
            {
                if (manualEntrance == null || manualExit == null)
                    throw new ArgumentException("Неверные позиции входа или выхода!");
                if (!IsValidEntranceExit(manualEntrance.Value, manualExit.Value, maze.Width, maze.Height))
                    throw new ArgumentException("Неверные позиции входа или выхода!");
                maze.Entrance = manualEntrance.Value;
                maze.Exit = manualExit.Value;
            }
            maze.Grid[maze.Entrance.X, maze.Entrance.Y] = 1;
            maze.Grid[maze.Exit.X, maze.Exit.Y] = 1;
        }

        private List<Point> GetPerimeterCells(int width, int height)
        {
            var list = new List<Point>();
            for (int x = 0; x < width; x++)
            {
                if (x != 0 && x != width - 1)
                {
                    list.Add(new Point(x, 0));
                    list.Add(new Point(x, height - 1));
                }
            }
            for (int y = 0; y < height; y++)
            {
                if (y != 0 && y != height - 1)
                {
                    list.Add(new Point(0, y));
                    list.Add(new Point(width - 1, y));
                }
            }
            return list;
        }

        private bool IsValidEntranceExit(Point a, Point b, int width, int height)
        {
            if (a == b) return false;
            if ((a.X == 0 || a.X == width - 1 || a.Y == 0 || a.Y == height - 1) &&
                (b.X == 0 || b.X == width - 1 || b.Y == 0 || b.Y == height - 1))
            {
                if ((a.X == 0 && a.Y == 0) || (a.X == 0 && a.Y == height - 1) ||
                    (a.X == width - 1 && a.Y == 0) || (a.X == width - 1 && a.Y == height - 1))
                    return false;
                if ((b.X == 0 && b.Y == 0) || (b.X == 0 && b.Y == height - 1) ||
                    (b.X == width - 1 && b.Y == 0) || (b.X == width - 1 && b.Y == height - 1))
                    return false;
                if (Math.Abs(a.X - b.X) + Math.Abs(a.Y - b.Y) <= 1)
                    return false;
                return true;
            }
            return false;
        }

        public void GenerateMaze(Maze maze, string algorithm)
        {
            if (algorithm == "Прима")
                GeneratePrim(maze);
            else if (algorithm == "Эллера")
                GenerateEller(maze);
        }

        // Алгоритм Прима
        private void GeneratePrim(Maze maze)
        {
            int w = maze.Width, h = maze.Height;
            var grid = maze.Grid;

            // 1. Все клетки - стены
            for (int i = 0; i < w; i++)
            {
                for (int j = 0; j < h; j++)
                {
                    grid[i, j] = 0;
                }
            }

            //// Восстановим периметр как стены (кроме входа/выхода)
            //for (int i = 0; i < w; i++)
            //{
            //    if (maze.Entrance != new Point(i, 0) && maze.Exit != new Point(i, 0))
            //        grid[i, 0] = 0;
            //    if (maze.Entrance != new Point(i, h - 1) && maze.Exit != new Point(i, h - 1))
            //        grid[i, h - 1] = 0;
            //}
            //for (int j = 0; j < h; j++)
            //{
            //    if (maze.Entrance != new Point(0, j) && maze.Exit != new Point(0, j))
            //        grid[0, j] = 0;
            //    if (maze.Entrance != new Point(w - 1, j) && maze.Exit != new Point(w - 1, j))
            //        grid[w - 1, j] = 0;
            //}

            // 2. Выбираем случайную клетку с нечетными координатами и очищаем её
            int x = rand.Next(w / 2) * 2 + 1;
            int y = rand.Next(h / 2) * 2 + 1;
            grid[x, y] = 1;

            // 3. Создаем список клеток для проверки - клетки на расстоянии 2 ортогонального пространства
            var toCheck = new List<Point>();
            AddNeighborsToCheck(toCheck, x, y, w, h, grid);

            // 4. Основной цикл
            while (toCheck.Count > 0)
            {
                // Выбираем случайную клетку
                int index = rand.Next(toCheck.Count);
                Point cell = toCheck[index];
                x = cell.X;
                y = cell.Y;
                grid[x, y] = 1;
                toCheck.RemoveAt(index);

                // Ищем соседнюю уже очищенную клетку и соединяем их
                var directions = new List<(int dx, int dy)> { (0, -2), (0, 2), (-2, 0), (2, 0) };
                
                bool connected = false;
                while (directions.Count > 0 && !connected)
                {
                    int dirIndex = rand.Next(directions.Count);
                    var (dx, dy) = directions[dirIndex];
                    int nx = x + dx;
                    int ny = y + dy;

                    if (nx >= 0 && nx < w && ny >= 0 && ny < h && grid[nx, ny] == 1)
                    {
                        // Очищаем клетку между ними (соединяем)
                        grid[x + dx / 2, y + dy / 2] = 1;
                        connected = true;
                    }

                    directions.RemoveAt(dirIndex);
                }

                // Добавляем соседние клетки на расстоянии 2, которые еще стены
                AddNeighborsToCheck(toCheck, x, y, w, h, grid);
            }

            // Убедитесь, что вход и выход открыты
            grid[maze.Entrance.X, maze.Entrance.Y] = 1;
            grid[maze.Exit.X, maze.Exit.Y] = 1;
        }

        private void AddNeighborsToCheck(List<Point> toCheck, int x, int y, int w, int h, int[,] grid)
        {
            if (y - 2 >= 0 && grid[x, y - 2] == 0 && !toCheck.Contains(new Point(x, y - 2)))
                toCheck.Add(new Point(x, y - 2));
            if (y + 2 < h && grid[x, y + 2] == 0 && !toCheck.Contains(new Point(x, y + 2)))
                toCheck.Add(new Point(x, y + 2));
            if (x - 2 >= 0 && grid[x - 2, y] == 0 && !toCheck.Contains(new Point(x - 2, y)))
                toCheck.Add(new Point(x - 2, y));
            if (x + 2 < w && grid[x + 2, y] == 0 && !toCheck.Contains(new Point(x + 2, y)))
                toCheck.Add(new Point(x + 2, y));
        }

        // Алгоритм Эллера
        private void GenerateEller(Maze maze)
        {
            int w = maze.Width, h = maze.Height;
            var grid = maze.Grid;

            // 1. Все клетки - стены
            for (int x = 0; x < w; x++)
            {
                for (int y = 0; y < h; y++)
                {
                    grid[x, y] = 0;
                }
            }

            // Восстановим периметр как стены (кроме входа/выхода)
            for (int x = 0; x < w; x++)
            {
                if (maze.Entrance != new Point(x, 0) && maze.Exit != new Point(x, 0))
                    grid[x, 0] = 0;
                if (maze.Entrance != new Point(x, h - 1) && maze.Exit != new Point(x, h - 1))
                    grid[x, h - 1] = 0;
            }
            for (int y = 0; y < h; y++)
            {
                if (maze.Entrance != new Point(0, y) && maze.Exit != new Point(0, y))
                    grid[0, y] = 0;
                if (maze.Entrance != new Point(w - 1, y) && maze.Exit != new Point(w - 1, y))
                    grid[w - 1, y] = 0;
            }

            // 2. Создаем сетку размерами для отслеживания множеств
            int[,] sets = new int[w, h];
            int setId = 1;

            // 3. Основной цикл по строкам (не последняя строка, только строки с нечетными координатами)
            for (int i = 1; i < h - 2; i += 2)
            {
                // 3.1. Присвоить уникальный номер каждой ячейке
                for (int j = 1; j < w - 1; j += 2)
                {
                    grid[j, i] = 1;
                    if (sets[j, i] == 0)
                        sets[j, i] = setId++;
                }

                // 3.2. Процесс горизонтального соединения (обработка вертикальных стен)
                for (int j = 1; j < w - 2; j += 2)
                {
                    int set1 = sets[j, i];
                    int set2 = sets[j + 2, i];

                    // Если разные множества - ВСЕГДА убираем стену
                    if (set1 != set2)
                    {
                        grid[j + 1, i] = 1;
                        // Объединяем множества
                        MergeSets(sets, set1, set2);
                    }
                    else
                    {
                        // Если одно множество - случайно убираем стену
                        if (rand.Next(2) == 0)
                        {
                            grid[j + 1, i] = 1;
                        }
                    }
                }

                // 3.3. Процесс вертикального соединения (обработка горизонтальных стен)
                var setToHasDown = new Dictionary<int, bool>();
                for (int j = 1; j < w - 1; j += 2)
                {
                    int set = sets[j, i];
                    if (!setToHasDown.ContainsKey(set))
                    {
                        setToHasDown[set] = false;
                    }

                    // Проверяем, что мы не выходим за периметр
                    if (i + 2 < h - 1)
                    {
                        // Случайно убираем стену вниз
                        if (rand.Next(2) == 0)
                        {
                            grid[j, i + 1] = 1;
                            setToHasDown[set] = true;
                        }
                    }
                }

                // 3.4. Убедитесь, что каждое множество имеет хотя бы один проход вниз
                for (int j = 1; j < w - 1; j += 2)
                {
                    int set = sets[j, i];
                    if (!setToHasDown[set] && i + 2 < h - 1)
                    {
                        grid[j, i + 1] = 1;
                        setToHasDown[set] = true;
                    }
                }

                // 3.5. Сбросить множества для следующей строки
                if (i + 2 < h - 1)
                {
                    for (int j = 1; j < w - 1; j += 2)
                    {
                        if (grid[j, i + 1] == 0) // Если нет проходу вниз
                            sets[j, i + 2] = 0; // Новое множество
                        else
                            sets[j, i + 2] = sets[j, i]; // Наследуем множество
                    }
                }
            }

            // 4. Последняя внутренняя строка (перед нижним периметром)
            int lastRow = h - 2;
            if (lastRow > 1 && lastRow % 2 == 0)
            {
                lastRow--;
            }

            for (int j = 1; j < w - 1; j += 2)
            {
                grid[j, lastRow] = 1;
                if (sets[j, lastRow] == 0)
                    sets[j, lastRow] = setId++;
            }

            // Соединяем горизонтально на последней строке
            for (int j = 1; j < w - 2; j += 2)
            {
                int set1 = sets[j, lastRow];
                int set2 = sets[j + 2, lastRow];

                if (set1 != set2)
                {
                    grid[j + 1, lastRow] = 1;
                    MergeSets(sets, set1, set2);
                }
                else
                {
                    if (rand.Next(2) == 0)
                    {
                        grid[j + 1, lastRow] = 1;
                    }
                }
            }

            // Убедитесь, что вход и выход открыты
            grid[maze.Entrance.X, maze.Entrance.Y] = 1;
            grid[maze.Exit.X, maze.Exit.Y] = 1;
        }

        private void MergeSets(int[,] sets, int oldSet, int newSet)
        {
            for (int x = 0; x < sets.GetLength(0); x++)
            {
                for (int y = 0; y < sets.GetLength(1); y++)
                {
                    if (sets[x, y] == oldSet)
                        sets[x, y] = newSet;
                }
            }
        }

        public List<Maze> GetAllMazes() => mazes;

        public void SaveMaze(Maze maze)
        {
            mazes.Add(maze);
        }
    }
